# Required: use a managed PostgreSQL database such as Railway, Neon, or Supabase Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bakery?sslmode=require"
# Public URL of the deployed app. Use the same origin for the Socket.IO client.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000
# Optional integrations - not required for the core demo.
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""
INTERAKT_API_KEY=""
INTERAKT_WEBHOOK_SECRET=""
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_VERIFY_TOKEN=""
GOOGLE_MAPS_API_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
